/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
/*
